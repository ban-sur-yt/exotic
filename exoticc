	apply.TextColor3 = Color3.fromRGB(255, 255, 255)
	apply.Font = Enum.Font.FredokaOne
	apply.TextSize = 14
	apply.Parent = card
	corner(apply, 8)

	local function doApply()
		local value = tonumber(box.Text)
		if value then
			playSound()
			-- Click flash animation
			TweenService:Create(apply, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(54, 26) }):Play()
