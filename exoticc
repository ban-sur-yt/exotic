-- Aimlock keybind: capture new key + track holding (works even when gameProcessed)
UserInputService.InputBegan:Connect(function(input)
	if waitingAimKey then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			state.aimKey = input.KeyCode
		elseif input.UserInputType ~= Enum.UserInputType.Keyboard then
			state.aimKey = input.UserInputType
		else
			return
		end
		waitingAimKey = false
		aimKeyBtn.Text = "Hold: " .. state.aimKey.Name
		playSound()
		return
	end
	if input.KeyCode == state.aimKey or input.UserInputType == state.aimKey then
		state.aimHeld = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == state.aimKey or input.UserInputType == state.aimKey then
		state.aimHeld = false
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if waitingKeybind then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			openKey = input.KeyCode
			waitingKeybind = false
			keybindBtn.Text = "Open Key: " .. openKey.Name
			playSound()
		end
		return
	end
	if input.KeyCode == openKey then
		togglePanel()
	end
end)

