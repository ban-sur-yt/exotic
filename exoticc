--// Tab system
local tabs = {}

local function selectTab(name)
	for n, data in pairs(tabs) do
		local selected = (n == name)
		data.frame.Visible = selected
		data.button.BackgroundColor3 = selected and ACCENT or Color3.fromRGB(52, 52, 58)
		data.button.TextColor3 = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(190, 190, 200)
	end
end

local function makeTab(name, order)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Size = UDim2.new(1, 0, 0, 36)
	btn.BackgroundColor3 = Color3.fromRGB(38, 38, 44)
	btn.TextColor3 = Color3.fromRGB(200, 200, 210)
	btn.Font = Enum.Font.FredokaOne
	btn.TextSize = 16
	btn.Text = name
	btn.LayoutOrder = order
	btn.AutoButtonColor = false
	btn.Parent = tabHolder
	corner(btn, 10)
	local btnPad = Instance.new("UIPadding")
	btnPad.PaddingLeft = UDim.new(0, 12)
	btnPad.Parent = btn
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.MouseButton1Click:Connect(function()
		playSound()
		-- Click pop animation
		TweenService:Create(btn, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(1, -6, 0, 32) }):Play()
		task.delay(0.08, function()
			TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, 36) }):Play()
		end)
		selectTab(name)
	end)

	local frame = Instance.new("Frame")
	frame.Name = name .. "Content"
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundTransparency = 1
	frame.Visible = false
	frame.Parent = content

	tabs[name] = { button = btn, frame = frame }
	return frame
end

