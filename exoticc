task.spawn(function()
	local frames, last = 0, os.clock()
	while true do
		RunService.RenderStepped:Wait()
		frames += 1
		local now = os.clock()
		if now - last >= 0.5 then
			local fps = math.floor(frames / (now - last) + 0.5)
			fpsLabel.Text = game.Name .. "  |  " .. fps .. " FPS"
			frames = 0
			last = now
		end
	end
end)

