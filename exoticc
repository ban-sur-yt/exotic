workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	fitPanel()
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(fitPanel)
	end
end)
local currentCam = workspace.CurrentCamera
if currentCam then
	currentCam:GetPropertyChangedSignal("ViewportSize"):Connect(fitPanel)
end

