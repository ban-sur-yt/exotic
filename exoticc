local targetScale = 1
local function fitPanel()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	-- Shrink the panel so it always fits the screen (never upscale)
	targetScale = math.clamp(math.min(vp.X / 660, vp.Y / 460), 0.5, 1)
	uiScale.Scale = targetScale
end
