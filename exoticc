local FLY_SPEED = 60
RunService.RenderStepped:Connect(function()
	if not state.fly then return end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end

	local move = hum.MoveDirection * FLY_SPEED
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) or hum.Jump then
		move += Vector3.new(0, FLY_SPEED, 0)
	elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
		move -= Vector3.new(0, FLY_SPEED, 0)
	end
	hrp.AssemblyLinearVelocity = move
end)

-- Autofarm: teleport to every candy on the map, one after another
task.spawn(function()
	while true do
		if state.autofarm then
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				-- Find the nearest candy on the map (any part with "candy" in its name)
				local nearest, nearestDist = nil, math.huge
				for _, d in workspace:GetDescendants() do
					if d:IsA("BasePart") and string.find(string.lower(d.Name), "candy", 1, true) then
						local dist = (d.Position - hrp.Position).Magnitude
						if dist < nearestDist then
							nearest, nearestDist = d, dist
					end
					end
				end
				if nearest then
					farmStatusLabel.Text = "Status: Teleporting to candy..."
					-- Teleport right on top of the candy
					hrp.CFrame = CFrame.new(nearest.Position + Vector3.new(0, 3, 0))
					-- Give the candy a moment to be collected before moving on
					task.wait(0.5)
				else
					farmStatusLabel.Text = "Status: No candy found, searching..."
					task.wait(0.5)
				end
			else
				task.wait(0.5)
			end
		else
			task.wait(0.25)
		end
	end
end)

-- Aimbot: lock camera onto nearest player
local function getNearestTarget()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local nearest, nearestDist = nil, math.huge
	for _, plr in Players:GetPlayers() do
		if plr ~= LocalPlayer then
			local tChar = plr.Character
			local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
			local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
			if tHrp and tHum and tHum.Health > 0 then
				local dist = (tHrp.Position - hrp.Position).Magnitude
				if dist < nearestDist then
				nearest, nearestDist = tHrp, dist
				end
			end
		end
	end
	return nearest
end

