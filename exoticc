				TweenService:Create(apply, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(60, 28) }):Play()
			end)
			callback(value)
		end
	end

	apply.MouseButton1Click:Connect(doApply)
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then doApply() end
	end)
end

